  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "prettier": "^3.0.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0 <23"
